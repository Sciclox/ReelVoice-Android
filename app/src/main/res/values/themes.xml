<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ReelVoice" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorPrimaryContainer">@color/bg_card_secondary</item>
        <item name="colorOnPrimaryContainer">@color/neon_cyan</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/neon_purple</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>
</resources>
