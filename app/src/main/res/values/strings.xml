    <string name="cmd_like">"Like" / "Me gusta"</string>
    <string name="cmd_like_desc">Da me gusta con doble toque en el centro</string>
    <string name="cmd_pause">"Pausa" / "Play"</string>
    <string name="cmd_pause_desc">Pausa o reproduce el video actual</string>
    
